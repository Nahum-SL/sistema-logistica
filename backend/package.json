{
  "name": "backend",
  "version": "1.0.0",
  "description": "API del sistema de gestión logística de Yonda Perú S.A.",
  "main": "src/server.ts",
  "scripts": {
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "dev:test": "tsx watch --env-file=.env.test src/server.ts",
    "start": "node --env-file=.env.production dist/server.js",
    "build": "tsc",
    "db:check": "tsx src/database/test-connection.ts",
    "knex": "tsx ./node_modules/knex/bin/cli.js",
    "migrate:make": "pnpm knex migrate:make",
    "migrate:latest": "pnpm knex migrate:latest",
    "migrate:rollback": "pnpm knex migrate:rollback",
    "migrate:status": "pnpm knex migrate:status",
    "seed:make": "pnpm knex seed:make",
    "seed:run": "pnpm knex seed:run",
    "migrate:prod": "tsx --env-file=.env.production ./node_modules/knex/bin/cli.js migrate:latest",
    "migrate:status:prod": "tsx --env-file=.env.production ./node_modules/knex/bin/cli.js migrate:status",
    "seed:prod": "tsx --env-file=.env.production ./node_modules/knex/bin/cli.js seed:run",
    "build:frontend": "pnpm --filter frontend build",
    "build:all": "pnpm build && pnpm build:frontend",
    "smoke": "node ops/smoke.mjs"
  },
  "keywords": [],
  "author": "Nahun Miguel Salazar Levano",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
